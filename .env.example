# Copy to .env.local (git-ignored) for local dev. Set the same two names in
# Netlify: Site configuration > Environment variables.
# Both are safe to expose in the browser; row level security is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
